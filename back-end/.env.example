# Backend & Serverless Functions Environment Variables
# Copy this file to .env and fill in your own project values.
# NEVER commit real secrets to version control.

# Supabase (Server-side Admin)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Payments & Webhooks
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Transactional Emails (Resend)
RESEND_API_KEY=re_your-resend-api-key
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# Application & Cron Security
FRONTEND_URL=http://localhost:5173
CRON_SECRET=your-random-cron-secret
PORT=3001
