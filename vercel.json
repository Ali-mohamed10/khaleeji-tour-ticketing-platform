{
  "buildCommand": "cd book-ticket && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "book-ticket/dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/expire-reservations",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
